// Cidade brutalista/liminar. Sombreamento lambertiano + oclusão pré-calculados por vértice
// (CityMeshBuilder) para caber em GPUs modestas de aparelhos de 4 GB; o canal alfa da cor
// do vértice marca superfícies emissivas (janelas, luminárias), que viram HDR > 1 e
// alimentam o bloom/halação.
//
// v3.5: texturas PBR procedurais KTX2 (concreto brutalista e carpete/papel de parede
// Backrooms; RGB = albedo de detalhe, A = rugosidade) amostradas em projeção triplanar a
// partir da posição de mundo, com a normal reconstruída por derivadas de tela (a malha não
// carrega UVs nem normais). A rugosidade modula um especular difuso de Blinn-Phong
// aproximado em direção à luz fixa da cidade, preservando o material unlit barato.
material {
    name : girassol_city,
    shadingModel : unlit,
    requires : [ color ],
    parameters : [
        { type : float4, name : tint },
        { type : float, name : emissiveBoost },
        { type : sampler2d, name : concreteTex, precision : medium },
        { type : sampler2d, name : carpetTex, precision : medium },
        // x = intensidade do detalhe (0 desliga), y = escala (tiles por repetição)
        { type : float2, name : detail },
        // v3.9: sol dinâmico (ciclo dia/noite contínuo). sunAmount = 0 ⇒ só a luz assada.
        { type : float3, name : sunDir },
        { type : float, name : sunAmount }
    ],
    culling : back
}

fragment {
    vec4 girassolTriplanar(sampler2D tex, highp vec3 p, vec3 w, float scale) {
        vec4 x = texture(tex, p.zy * scale);
        vec4 y = texture(tex, p.xz * scale);
        vec4 z = texture(tex, p.xy * scale);
        return x * w.x + y * w.y + z * w.z;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 c = getColor();
        vec3 base = c.rgb * materialParams.tint.rgb;
        float emissive = c.a * materialParams.emissiveBoost;
        float amount = materialParams.detail.x;
        if (amount > 0.0) {
            highp vec3 p = getUserWorldPosition();
            vec3 n = normalize(cross(dFdx(p), dFdy(p)));
            vec3 w = pow(abs(n), vec3(4.0));
            w /= max(w.x + w.y + w.z, 1e-4);
            float scale = materialParams.detail.y;
            // piso (normal para cima, rente ao chão) usa o carpete; paredes e lajes, o concreto
            float floorMask = step(0.8, abs(n.y)) * (1.0 - step(0.06, p.y));
            vec4 concrete = girassolTriplanar(materialParams_concreteTex, p, w, scale);
            vec4 carpet = girassolTriplanar(materialParams_carpetTex, p, w, scale * 1.6);
            vec4 t = mix(concrete, carpet, floorMask);
            vec3 albedo = t.rgb * 2.0;                 // detalhe centrado em 0.5
            float roughness = t.a;
            vec3 l = normalize(vec3(-0.45, 1.0, -0.3));
            vec3 v = normalize(getWorldCameraPosition() - getWorldPosition());
            vec3 h = normalize(l + v);
            float gloss = mix(48.0, 4.0, roughness);
            float spec = pow(max(dot(n, h), 0.0), gloss) * (1.0 - roughness) * 0.35;
            base = mix(base, base * albedo + spec * materialParams.tint.rgb, amount);
        }
        // Lambert direcional do sol sobre a luz assada (normal facetada pelas derivadas de tela);
        // faces contra o sol escurecem suavemente — sombra própria macia, coerente com a hora.
        highp vec3 wp = getUserWorldPosition();
        vec3 fn = normalize(cross(dFdx(wp), dFdy(wp)));
        // faces visíveis sempre olham para a câmera (culling back): independe do sinal de dFdy do backend
        if (dot(fn, getWorldCameraPosition() - getWorldPosition()) < 0.0) fn = -fn;
        float ndl = max(dot(fn, normalize(materialParams.sunDir)), 0.0);
        float sunTerm = mix(1.0, 0.62 + 0.62 * ndl, materialParams.sunAmount);
        // emissivo (janelas, postes) não depende do sol
        material.baseColor = vec4(base * sunTerm + base * emissive, 1.0);
    }
}
