// Pós-processamento analógico "Dehancer / Kodak 500T" do Projeto Girassol.
// A View principal renderiza a cidade num RenderTarget (já com tonemapping Filmic e a
// gradação 500T); esta passagem de tela cheia (triângulo em espaço de dispositivo) aplica
// os quatro efeitos analógicos sobre a imagem:
//   1. bloom   — difusão gaussiana dupla (raio curto + raio largo) das altas luzes;
//   2. halação — franja vermelho-alaranjada (1.0, 0.32, 0.12) que vaza da camada de
//                emulsão vermelha ao redor das fontes de luz, como no filme sem anti-halo;
//   3. sombras densas — "toe" da curva característica: pretos comprimidos e levemente
//                frios, sem esmagar os meios-tons;
//   4. grão Kodak — ruído animado por quadro, dependente da luminância (mais forte nos
//                meios-tons), com agregados por canal para o aspecto de cristais de prata.
// O custo é fixo (26 amostras) e independente da cena, adequado a GPUs Adreno/Mali de
// entrada a 30 fps; níveis de efeito inferiores desligam esta passagem.
material {
    name : girassol_dehancer_post,
    shadingModel : unlit,
    vertexDomain : device,
    requires : [ uv0 ],
    depthWrite : false,
    depthCulling : false,
    culling : none,
    parameters : [
        { type : sampler2d, name : sceneColor, precision : medium },
        { type : float2, name : texelSize },
        // x = bloom, y = halação, z = densidade das sombras, w = grão
        { type : float4, name : strength },
        { type : float, name : time }
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
    }
}

fragment {
    float girassolLuma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

    float girassolHash(vec2 p) {
        vec3 p3 = fract(vec3(p.xyx) * 0.1031);
        p3 += dot(p3, p3.yzx + 33.33);
        return fract((p3.x + p3.y) * p3.z);
    }

    // Altas luzes acima do limiar, com joelho suave.
    vec3 girassolBright(vec3 c) {
        float l = girassolLuma(c);
        float k = smoothstep(0.55, 0.95, l);
        return c * k;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        highp vec2 uv = uvToRenderTargetUV(getUV0());
        vec2 px = materialParams.texelSize;
        vec3 base = textureLod(materialParams_sceneColor, uv, 0.0).rgb;

        // --- 1 + 2: bloom e halação (anel de 12 amostras em dois raios + centro) ---
        vec3 nearSum = girassolBright(base);
        vec3 wideSum = vec3(0.0);
        const float TAU = 6.2831853;
        for (int i = 0; i < 12; i++) {
            float a = TAU * (float(i) + 0.5) / 12.0;
            vec2 dir = vec2(cos(a), sin(a));
            nearSum += girassolBright(textureLod(materialParams_sceneColor, uv + dir * px * 3.5, 0.0).rgb);
            wideSum += girassolBright(textureLod(materialParams_sceneColor, uv + dir * px * 11.0, 0.0).rgb);
        }
        vec3 bloomNear = nearSum / 13.0;
        vec3 bloomWide = wideSum / 12.0;
        vec3 bloom = bloomNear * 0.6 + bloomWide * 0.4;
        vec3 halationTint = vec3(1.0, 0.32, 0.12);
        // a halação nasce do halo largo e não do núcleo: a luz atravessa a base e volta
        float halo = girassolLuma(max(bloomWide - bloomNear * 0.35, vec3(0.0)));
        vec3 halation = halationTint * halo;

        vec3 c = base + bloom * materialParams.strength.x + halation * materialParams.strength.y;

        // --- 3: sombras densas (toe da curva característica) ---
        float l = girassolLuma(c);
        float toe = materialParams.strength.z;
        float dense = l / (l + toe * (1.0 - l) + 1e-4);          // comprime perto do preto
        float shadowMask = 1.0 - smoothstep(0.0, 0.35, l);
        c *= mix(1.0, dense / max(l, 1e-4), shadowMask);
        c = mix(c, c * vec3(0.92, 0.97, 1.06), shadowMask * 0.5); // pretos levemente frios

        // --- 4: grão de filme Kodak (dependente da luminância, por canal) ---
        vec2 cell = floor(gl_FragCoord.xy / 1.5);
        float t = floor(materialParams.time * 24.0);               // 24 quadros/s como no filme
        float gR = girassolHash(cell + vec2(t * 13.1, t * 7.7));
        float gG = girassolHash(cell + vec2(t * 3.3 + 17.0, t * 11.9));
        float gB = girassolHash(cell + vec2(t * 5.9 + 41.0, t * 2.1));
        vec3 grain = vec3(gR, gG * 0.85 + gR * 0.15, gB * 0.8 + gR * 0.2) - 0.5;
        float mid = 4.0 * l * (1.0 - l);                           // máximo nos meios-tons
        c += grain * materialParams.strength.w * (0.35 + 0.65 * mid);

        material.baseColor = vec4(max(c, vec3(0.0)), 1.0);
    }
}
